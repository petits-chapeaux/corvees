# Copy to .env.production, chmod 600, and generate each password with openssl rand -hex 32.
# Hexadecimal passwords avoid connection-string and Compose interpolation delimiters.
POSTGRES_PASSWORD=
CORVEES_OPERATOR_PASSWORD=
CORVEES_APP_PASSWORD=

# Use a new, immutable label for each build. Never rebuild a deployed label.
CORVEES_RELEASE=
CORVEES_ALLOWED_HOSTS=localhost;127.0.0.1
CORVEES_HTTP_PORT=5169
